{
  "name": "Rosé Ledger",
  "version": 1,
  "color": {
    "themes": [
      { "id": "light", "name": "Day" },
      { "id": "dark", "name": "Night" }
    ],
    "tokens": [
      { "name": "page", "value": "#ECE5D7", "dark": "#0E0C0D", "usage": "Ground behind the app." },
      { "name": "paper", "value": "#F6F1E6", "dark": "#171415", "usage": "App background, under the ledger rules." },
      { "name": "sheet", "value": "#FFFDF8", "dark": "#201B1D", "usage": "Cards: the paper sheets everything sits on." },
      { "name": "rule", "value": "#ECE5D6", "dark": "#211C1E", "usage": "The 44px ledger lines behind the scrolling screen." },
      { "name": "ink", "value": "#2B1A24", "dark": "#F1EAE4", "usage": "Wine-black ink for headlines, text and the filled pill buttons." },
      { "name": "line", "value": "#E4DCCB", "dark": "#352D30", "usage": "Hairline borders, row rules, dotted leaders." },
      { "name": "track", "value": "#EEE7D9", "dark": "#2C2528", "usage": "Empty part of progress bars, segmented controls." },
      { "name": "accent", "value": "#9B2C4B", "dark": "#E07A97", "usage": "Raspberry burgundy, Mira's colour: the full stop after big numbers, the pace line, heatmap." },
      { "name": "shaun", "value": "#3E64A8", "dark": "#8DB0EE", "usage": "Denim blue, the partner's colour: their dot, their bars." },
      { "name": "sun", "value": "#F3B94D", "dark": "#F5C66A", "usage": "Marigold pop: the round sticker, highlights, the active-tab dot. One or two per screen." },
      { "name": "good", "value": "#4E8A6B", "dark": "#7CC4A0", "usage": "On track." },
      { "name": "warn", "value": "#E39A1F", "dark": "#F2B64A", "usage": "Spending fast." },
      { "name": "bad", "value": "#D2452C", "dark": "#F07A5E", "usage": "Over budget, the budget line." },
      { "name": "tint-a", "value": "#6FA88C", "usage": "Sage tile. Tiles mix 24% of the tint into the sheet; their text mixes 62% of it into the ink." },
      { "name": "tint-b", "value": "#E07A8F", "usage": "Rose tile." },
      { "name": "tint-c", "value": "#F2C14E", "usage": "Butter tile (30% mix, 45% text)." },
      { "name": "tint-d", "value": "#6F8FD8", "usage": "Cornflower tile." }
    ]
  },
  "type": {
    "families": {
      "display": "'Fraunces', 'Iowan Old Style', Georgia, serif",
      "body": "'Hanken Grotesk', 'Helvetica Neue', Arial, system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace"
    },
    "fonts": "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500..900&family=Hanken+Grotesk:wght@400..700&family=JetBrains+Mono:wght@400..700&display=swap",
    "groups": [
      { "name": "Hero number", "family": "display", "styles": [ { "name": "big", "fontSize": "58px", "lineHeight": "0.95", "fontWeight": 800, "letterSpacing": "-0.035em" } ] },
      { "name": "Headings", "family": "display", "styles": [ { "name": "card", "fontSize": "22px", "lineHeight": "1.05", "fontWeight": 800, "letterSpacing": "-0.035em" }, { "name": "row", "fontSize": "19px", "fontWeight": 500 } ] },
      { "name": "Body", "family": "body", "styles": [ { "name": "body", "fontSize": "14.5px", "lineHeight": "1.45", "fontWeight": 400 }, { "name": "caption", "fontSize": "12.5px", "fontWeight": 400 } ] },
      { "name": "Figures and labels", "family": "mono", "styles": [ { "name": "figure", "fontSize": "15px", "fontVariantNumeric": "tabular-nums" }, { "name": "eyebrow", "fontSize": "10px", "letterSpacing": "0.22em", "textTransform": "uppercase", "fontWeight": 500 } ] }
    ]
  },
  "spacing": { "gutter": "16px", "card-pad": "18px", "gap": "16px", "rule": "44px" },
  "radius": { "card": "22px", "tile": "16px", "pill": "999px", "phone": "46px" }
}

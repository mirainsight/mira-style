{
  "look": "grunge",
  "canvas": { "width": 1080, "height": 1350, "ratio": "4:5", "margin": 92, "export": "png" },
  "palettes": {
    "night":   { "name": "Night",   "base": "#100a08", "glows": ["#ec681c", "#f4a443", "#5d592b"], "ink": "#ea8a6b", "ink2": "#ea8a6b", "default": true },
    "moon":    { "name": "Moon",    "base": "#2a1d2e", "glows": ["#e8773a", "#4b3c66", "#2f8a88", "#f1a55a"], "ink": "#f7ebe1", "ink2": "#ffd0b4" },
    "ember":   { "name": "Ember",   "base": "#3e0f10", "glows": ["#f0ad24", "#d8471c", "#8b1c14", "#5c1515"], "ink": "#f6ebe0", "ink2": "#f2b490" },
    "olive":   { "name": "Olive",   "base": "#38382a", "glows": ["#d6651b", "#c4561a", "#4b4a30"], "ink": "#f3d8a4", "ink2": "#f3d8a4" },
    "street":  { "name": "Street",  "base": "#38251a", "glows": ["#b9763f", "#7a4826", "#e2a862", "#c0402a", "#d9d6c8"], "ink": "#dfe0d6", "ink2": "#dfe0d6" },
    "rust":    { "name": "Rust",    "base": "#e07a4e", "glows": ["#ea8d5d", "#d2683e", "#f19d6e"], "ink": "#1d1613", "ink2": "#2e1a14" },
    "mustard": { "name": "Mustard", "base": "#e8a82c", "glows": ["#f2bf47", "#de8c20", "#e5791d"], "ink": "#5a2027", "ink2": "#5a2027" },
    "signal":  { "name": "Signal",  "base": "#bc1f1d", "glows": ["#c72b25", "#a9191a"], "ink": "#130a0a", "ink2": "#130a0a" }
  },
  "backgrounds": {
    "generated": {
      "glow":   "4-5 large radial blobs in the palette's glow colours, seeded per slide",
      "streak": "18 horizontal colour bands blurred sideways (feGaussianBlur stdDeviation 150 4)",
      "paper":  "one huge soft blob of the first glow colour",
      "flat":   "the palette's base colour only"
    },
    "photos": {
      "photo":  { "file": "backgrounds/moon.jpg", "note": "1080x1928, drifts 24px up per slide so the set reads as one strip, with a dark shade over it" },
      "path":   { "file": "backgrounds/wind2-soft.jpg" },
      "pathf":  { "file": "backgrounds/wind2-faint.jpg" },
      "hand":   { "file": "backgrounds/hand-soft.jpg" },
      "handf":  { "file": "backgrounds/hand-faint.jpg" }
    },
    "perSlide": true
  },
  "texture": {
    "grain": { "default": 32, "range": [0, 100], "blend": "overlay", "opacity": "grain/100 * 0.95", "tile": 260, "noise": "feTurbulence fractalNoise baseFrequency .85, 3 octaves, desaturated" },
    "dust": { "default": false, "note": "1300 specks and 46 hairline scratches, dark and light" }
  },
  "type": {
    "smallSize": 46,
    "fonts": {
      "gloock":      { "name": "Gloock",               "family": "'Gloock', Georgia, serif",                          "weightBig": 400, "weightSmall": 400, "k": 1,    "lineHeight": 1.02, "letterSpacing": "-0.01em" },
      "instrument":  { "name": "Instrument Serif",     "family": "'Instrument Serif', Georgia, serif",                "weightBig": 400, "weightSmall": 400, "k": 1.14, "lineHeight": 1,    "letterSpacing": "-0.01em" },
      "fraunces":    { "name": "Fraunces",             "family": "'Fraunces', Georgia, serif",                        "weightBig": 800, "weightSmall": 600, "k": 0.96, "lineHeight": 1.04, "letterSpacing": "-0.01em" },
      "baskerville": { "name": "Libre Baskerville",    "family": "'Libre Baskerville', Georgia, serif",               "weightBig": 700, "weightSmall": 400, "k": 0.86, "lineHeight": 1.04, "letterSpacing": "-0.02em" },
      "bevan":       { "name": "Bevan",                "family": "'Bevan', Georgia, serif",                           "weightBig": 400, "weightSmall": 400, "k": 0.8,  "lineHeight": 1.04, "letterSpacing": "0" },
      "barlow":      { "name": "Barlow Condensed",     "family": "'Barlow Condensed', 'Arial Narrow', sans-serif",    "weightBig": 700, "weightSmall": 600, "k": 1.12, "lineHeight": 0.93, "letterSpacing": "0" },
      "jost":        { "name": "Jost",                 "family": "'Jost', Futura, sans-serif",                        "weightBig": 800, "weightSmall": 700, "k": 0.96, "lineHeight": 0.96, "letterSpacing": "-0.01em" },
      "archivo":     { "name": "Archivo Black",        "family": "'Archivo Black', Helvetica, sans-serif",            "weightBig": 400, "weightSmall": 400, "k": 0.88, "lineHeight": 1,    "letterSpacing": "-0.02em" },
      "fredoka":     { "name": "Fredoka",              "family": "'Fredoka', sans-serif",                             "weightBig": 700, "weightSmall": 600, "k": 1,    "lineHeight": 0.96, "letterSpacing": "0" },
      "newsreader":  { "name": "Newsreader",           "family": "'Newsreader', Georgia, serif",                      "weightBig": 400, "weightSmall": 400, "k": 1,    "lineHeight": 1.08, "letterSpacing": "-0.02em", "default": true },
      "gaegu":       { "name": "Gaegu (handwritten)",  "family": "'Gaegu', 'Comic Sans MS', cursive",                 "weightBig": 700, "weightSmall": 400, "k": 1.18, "lineHeight": 1.05, "letterSpacing": "0.01em" },
      "scrawl":      { "name": "Brush scrawl",         "family": "'Covered By Your Grace', 'Brush Script MT', cursive", "weightBig": 400, "weightSmall": 400, "k": 1.3, "lineHeight": 1.05, "letterSpacing": "0" },
      "marker":      { "name": "Hand marker",          "family": "'Delicious Handrawn', 'Comic Sans MS', cursive",    "weightBig": 400, "weightSmall": 400, "k": 1.12, "lineHeight": 1.05, "letterSpacing": "0.01em" }
    },
    "weights": { "thin": 200, "regular": 400, "semibold": 600, "bold": 800 },
    "note": "k scales every size for that face, because the faces run at very different sizes. Font files for PNG export are in example/fonts/."
  },
  "layouts": {
    "whisper": { "name": "Whisper", "font": "gloock",      "case": "lowercase", "bigSize": 0,   "idea": "small, quiet, centred like a breath" },
    "split":   { "name": "Split",   "font": "barlow",      "case": "uppercase", "bigSize": 170, "idea": "condensed caps pushed to opposite edges, last word italic", "harderToRead": true },
    "aside":   { "name": "Aside",   "font": "fraunces",    "case": "none",      "bigSize": 0,   "idea": "one small column, off-centre right" },
    "corners": { "name": "Corners", "font": "jost",        "case": "uppercase", "bigSize": 120, "idea": "lines thrown to alternating edges, a page number top right" },
    "echo":    { "name": "Echo",    "font": "archivo",     "case": "none",      "bigSize": 170, "idea": "one line repeated and smeared, or overlaid with a second-ink ghost" },
    "arc":     { "name": "Arc",     "font": "fraunces",    "case": "none",      "bigSize": 0,   "idea": "text travels a curve", "harderToRead": true },
    "stack":   { "name": "Stack",   "font": "baskerville", "case": "none",      "bigSize": 190, "idea": "big words stacked left, quiet italic on the right" },
    "fill":    { "name": "Fill",    "font": "fredoka",     "case": "uppercase", "bigSize": 160, "idea": "rounded caps justified across the whole width", "harderToRead": true }
  },
  "effects": {
    "blur": { "default": 12, "modes": ["smear", "soft", "none"], "smear": "4 stacked sideways text-shadows, each a quarter further out and fainter", "soft": "filter: blur(blur/4 px)", "targets": ["none", "big line", "small text", "everything"] },
    "echo": { "modes": ["rows", "overlay"], "strength": { "clear": 0.45, "medium": 1, "heavy": 1.7 } },
    "strikeThrough": { "path": "M0 60 C 25 50, 60 56, 100 40", "thickness": { "thin": 3, "normal": 6, "thick": 12 } },
    "highlight": { "auto": "block in the text colour, text knocked out in the palette base", "custom": "chosen block colour, text picks whichever of base or ink contrasts better" },
    "tilt": { "default": 0, "note": "no tilt unless asked" }
  },
  "rules": {
    "maxLayoutsPerSet": 3,
    "tiltByDefault": false
  }
}

{
  "name": "Graph Paper",
  "version": 1,
  "color": {
    "themes": [
      { "id": "light", "name": "Day" },
      { "id": "dark", "name": "Night" }
    ],
    "tokens": [
      { "name": "bg", "value": "#f7f8fa", "dark": "#11151d", "usage": "Page ground, and the header's paper under the grid." },
      { "name": "surface", "value": "#ffffff", "dark": "#181e29", "usage": "Table sheets, controls, the theme toggle." },
      { "name": "fg", "value": "#1a2233", "dark": "#e4e8ef", "usage": "Headings and body text." },
      { "name": "muted", "value": "#5b6577", "dark": "#98a2b3", "usage": "Leads, section subtitles, column labels, footer." },
      { "name": "line", "value": "#dde2ea", "dark": "#2a3242", "usage": "Hairline borders and row rules." },
      { "name": "grid", "value": "#e8ecf3", "dark": "#1a212d", "usage": "The 22px exam-paper grid behind the header only." },
      { "name": "accent", "value": "#1f4fa3", "dark": "#8fb0ee", "usage": "Ink blue, like an exam pen: eyebrow, links, selected chip, focus ring." },
      { "name": "accent-soft", "value": "#e5ecf8", "dark": "#1f2b42", "usage": "Quiet accent fills." },
      { "name": "star", "value": "#b4650a", "dark": "#f0b465", "usage": "Highlighter amber: 'start here' tags and the callout's edge. Use sparingly." },
      { "name": "star-soft", "value": "#fbefdf", "dark": "#33281a", "usage": "Callout and tag fill." }
    ]
  },
  "type": {
    "families": {
      "display": "'Newsreader', Georgia, 'Times New Roman', serif",
      "body": "'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, Consolas, monospace"
    },
    "fonts": "https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,500;6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap",
    "groups": [
      { "name": "Title", "family": "display", "styles": [ { "name": "h1", "fontSize": "clamp(30px, 6vw, 44px)", "lineHeight": "1.1", "fontWeight": 600 } ] },
      { "name": "Section", "family": "display", "styles": [ { "name": "h2", "fontSize": "23px", "lineHeight": "1.2", "fontWeight": 600 } ] },
      { "name": "Body", "family": "body", "styles": [ { "name": "body", "fontSize": "15px", "lineHeight": "1.55", "fontWeight": 400 }, { "name": "table", "fontSize": "14px", "lineHeight": "1.5", "fontWeight": 400 } ] },
      { "name": "Labels", "family": "mono", "styles": [ { "name": "eyebrow", "fontSize": "12px", "letterSpacing": "0.08em", "textTransform": "uppercase", "fontWeight": 500 }, { "name": "column", "fontSize": "11.5px", "letterSpacing": "0.06em", "textTransform": "uppercase", "fontWeight": 500 }, { "name": "code", "fontSize": "13px", "fontVariantNumeric": "tabular-nums" } ] }
    ]
  },
  "spacing": { "gutter": "16px", "column": "920px", "grid": "22px", "section": "34px" },
  "radius": { "sheet": "6px", "chip": "999px", "tag": "4px" }
}

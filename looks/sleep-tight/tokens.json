{
  "name": "Sleep Tight",
  "version": 1,
  "color": {
    "themes": [
      {
        "id": "post-copier",
        "name": "Mira's Post Copier"
      }
    ],
    "tokens": [
      {
        "name": "plum",
        "value": "#5a2338",
        "usage": "Ink of the whole look: titles, message text, postmark, address lines, sign-off. A warm plum-brown, never black."
      },
      {
        "name": "cream",
        "value": "#f0e5cc",
        "usage": "Paper. The postcard card, with paper grain over it."
      },
      {
        "name": "olive",
        "value": "#3b5530",
        "usage": "Dark stripe of the frame. Also the page ground when the stripes are off."
      },
      {
        "name": "sage",
        "value": "#c5cba3",
        "usage": "Light stripe of the frame, and the stamp."
      },
      {
        "name": "mustard",
        "value": "#d6952c",
        "usage": "Accent: the title's pop-out shadow, and the hero star's colour family."
      },
      {
        "name": "terracotta",
        "value": "#c9633f",
        "usage": "Secondary doodle warmth. Use sparingly."
      },
      {
        "name": "butter",
        "value": "#e8c46a",
        "usage": "Secondary doodle warmth."
      },
      {
        "name": "moss",
        "value": "#7a8f5a",
        "usage": "Secondary doodle green."
      }
    ]
  },
  "type": {
    "fonts": [],
    "families": {
      "title": "'Over the Rainbow', cursive",
      "body": "'Newsreader', Georgia, serif",
      "hand": "'Reenie Beanie', cursive",
      "title-over-the-rainbow": "'Over the Rainbow', cursive",
      "title-gaegu": "'Gaegu', cursive",
      "title-delicious-handrawn": "'Delicious Handrawn', cursive",
      "title-schoolbell": "'Schoolbell', cursive",
      "title-waiting-for-the-sunrise": "'Waiting for the Sunrise', cursive",
      "title-nanum-pen-script": "'Nanum Pen Script', cursive",
      "title-sue-ellen-francisco": "'Sue Ellen Francisco', cursive",
      "title-just-another-hand": "'Just Another Hand', cursive",
      "title-reenie-beanie": "'Reenie Beanie', cursive",
      "title-shantell-sans": "'Shantell Sans', cursive",
      "title-itim": "'Itim', cursive",
      "title-mansalva": "'Mansalva', cursive"
    },
    "groups": [
      {
        "name": "Title",
        "family": "title",
        "styles": [
          {
            "name": "title",
            "fontSize": "58px",
            "lineHeight": "1.1",
            "letterSpacing": "0.03em",
            "fontWeight": 700,
            "textStroke": "1.6px currentColor",
            "textShadow": "3px 3px 0 var(--mustard)",
            "rotate": "-3deg",
            "bounce": 3
          }
        ]
      },
      {
        "name": "Body",
        "family": "body",
        "styles": [
          {
            "name": "message",
            "fontSize": "17px",
            "lineHeight": "1.55",
            "fontWeight": 400
          },
          {
            "name": "message-bold",
            "fontSize": "17px",
            "lineHeight": "1.55",
            "fontWeight": 700
          },
          {
            "name": "message-italic",
            "fontSize": "17px",
            "lineHeight": "1.55",
            "fontWeight": 400,
            "fontStyle": "italic"
          }
        ]
      },
      {
        "name": "Hand",
        "family": "hand",
        "styles": [
          {
            "name": "address",
            "fontSize": "22px",
            "lineHeight": "1.5"
          },
          {
            "name": "sign-off",
            "fontSize": "33px",
            "lineHeight": "1"
          },
          {
            "name": "footer-line",
            "fontSize": "22px",
            "lineHeight": "1.5",
            "letterSpacing": "0.5em",
            "opacity": 0.38
          }
        ]
      }
    ],
    "variants": {
      "note": "Title font variants. Every variant takes the same treatment (bold stroke, mustard pop-out shadow, -3deg tilt, bounce 3) and has its own tuned size, line height and letter spacing. Offer these when asked for other handwritten-feel fonts.",
      "default": "Over the Rainbow",
      "treatment": {
        "fontWeight": 700,
        "textStroke": "1.6px currentColor",
        "textShadow": "3px 3px 0 var(--mustard)",
        "rotate": "-3deg",
        "bounce": 3,
        "fitToWidth": true
      },
      "fonts": [
        {
          "name": "Over the Rainbow",
          "fontSize": "58px",
          "lineHeight": "1.1",
          "letterSpacing": "0.03em",
          "note": "Default. Loose, airy and tall; closest to the poster's lettering."
        },
        {
          "name": "Gaegu",
          "fontSize": "67px",
          "lineHeight": "1.05",
          "letterSpacing": "0.04em",
          "note": "Friendly bouncy pen. The sturdiest all-rounder."
        },
        {
          "name": "Delicious Handrawn",
          "fontSize": "64px",
          "lineHeight": "1.0",
          "letterSpacing": "0.03em",
          "note": "The most wobble; looks hand-cut."
        },
        {
          "name": "Schoolbell",
          "fontSize": "55px",
          "lineHeight": "1.1",
          "letterSpacing": "0.06em",
          "note": "Rounder, chunkier marker."
        },
        {
          "name": "Waiting for the Sunrise",
          "fontSize": "58px",
          "lineHeight": "1.05",
          "letterSpacing": "0.03em",
          "note": "Light and airy, a little tall."
        },
        {
          "name": "Nanum Pen Script",
          "fontSize": "75px",
          "lineHeight": "1.0",
          "letterSpacing": "0.04em",
          "note": "Thin, quick pen strokes. Runs small, so set it larger."
        },
        {
          "name": "Sue Ellen Francisco",
          "fontSize": "87px",
          "lineHeight": "0.95",
          "letterSpacing": "0.06em",
          "note": "Tall and narrow; wide spacing suits it. Runs small."
        },
        {
          "name": "Just Another Hand",
          "fontSize": "93px",
          "lineHeight": "0.95",
          "letterSpacing": "0.06em",
          "note": "Tallest and narrowest. Runs very small, so set it much larger."
        },
        {
          "name": "Reenie Beanie",
          "fontSize": "87px",
          "lineHeight": "0.95",
          "letterSpacing": "0.04em",
          "note": "Scribbly. Best for short titles; runs small."
        },
        {
          "name": "Shantell Sans",
          "fontSize": "49px",
          "lineHeight": "1.1",
          "letterSpacing": "0.04em",
          "note": "Tidier and more legible; informal marker."
        },
        {
          "name": "Itim",
          "fontSize": "55px",
          "lineHeight": "1.1",
          "letterSpacing": "0.04em",
          "note": "Neat and rounded."
        },
        {
          "name": "Mansalva",
          "fontSize": "55px",
          "lineHeight": "1.1",
          "letterSpacing": "0.03em",
          "note": "Quick brush-pen look."
        }
      ]
    }
  },
  "spacing": {
    "tokens": [
      {
        "name": "frame-pad",
        "value": "34px",
        "usage": "Width of the striped frame around the card; doodles ride in it and overlap the card edge."
      },
      {
        "name": "card-pad-x",
        "value": "22px",
        "usage": "Side padding inside the card."
      },
      {
        "name": "card-pad-top",
        "value": "26px",
        "usage": "Top padding inside the card."
      },
      {
        "name": "block-gap",
        "value": "18px",
        "usage": "Gap before the sign-off row."
      }
    ]
  },
  "radius": {
    "tokens": [
      {
        "name": "radius-frame",
        "value": "6px",
        "usage": "The striped frame."
      },
      {
        "name": "radius-card",
        "value": "3px",
        "usage": "The card: almost square, like paper."
      }
    ]
  }
}